<Project>
  <PropertyGroup>
    <Authors>yourbirthcertificate</Authors>
    <Copyright>Copyright (c) 2026 yourbirthcertificate. PolyForm Noncommercial 1.0.0.</Copyright>
    <Version>0.2.0</Version>
    <!-- Single-file, self-contained exes when publishing for win-x64 -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>
</Project>
