<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OptiGame.Core\OptiGame.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>optigame</AssemblyName>
    <RootNamespace>OptiGame.Cli</RootNamespace>
    <Product>OptiGame+</Product>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- gameopt.exe: the old command name, a copy of optigame.exe next to it (build and publish). -->
  <Target Name="GameoptAlias" AfterTargets="Build;Publish">
    <PropertyGroup>
      <AliasDir Condition="'$(PublishDir)' != '' AND '$(_IsPublishing)' == 'true'">$(PublishDir)</AliasDir>
      <AliasDir Condition="'$(AliasDir)' == ''">$(OutDir)</AliasDir>
    </PropertyGroup>
    <Copy SourceFiles="$(AliasDir)optigame.exe" DestinationFiles="$(AliasDir)gameopt.exe" Condition="Exists('$(AliasDir)optigame.exe')" />
  </Target>

</Project>
