<UserControl x:Class="OptiGame.App.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OptiGame.App.Controls">
    <UserControl.Resources>
        <c:InvertBool x:Key="InvertBool" />
    </UserControl.Resources>

    <Grid Margin="36,24,36,20" MaxWidth="1180">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- Title and library actions -->
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Games" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding HardwareText}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DisplayText}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Add game folder…" Click="AddFolder_Click" Margin="0,0,8,0" Height="34" />
                    <Button Content="Manage folders…" Click="ManageFolders_Click" Margin="0,0,8,0" Height="34" />
                    <Button Content="Rescan" Click="Rescan_Click" Height="34" ToolTip="Look for installed games again (F5)" />
                </StackPanel>
            </Grid>

            <!-- All games -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="All games" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding GlobalLabel}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,24,0">
                        <Slider x:Name="GlobalSlider" Minimum="-3" Maximum="3" Value="{Binding GlobalOffset, Mode=TwoWay}"
                                AutomationProperties.Name="Quality offset for all games"
                                IsEnabled="{Binding Busy, Converter={StaticResource InvertBool}}" />
                        <Canvas x:Name="GlobalTicks" Height="22" ClipToBounds="False" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Back to recommended" Click="UseRecommended_Click" VerticalAlignment="Center" />
                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
                        <TextBlock Text="Default profile" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding DefaultProfileChoices}" SelectedValuePath="Key" SelectedValue="{Binding DefaultProfile}"
                                  Width="170" Margin="0,0,8,0" AutomationProperties.Name="Default profile" ToolTip="{Binding DefaultProfileText}" />
                        <Button Content="Profiles…" Click="Profiles_Click" Margin="0,0,24,0" />
                        <TextBlock Text="Gaming display" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding GamingDisplayChoices}" SelectedValuePath="Key" SelectedValue="{Binding GamingDisplay}"
                                  Width="300" AutomationProperties.Name="Gaming display" ToolTip="Used for resolution and the automatic frame cap. Windows display settings are never changed." />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Search, filters, selection -->
            <WrapPanel Margin="0,12,0,10">
                <TextBlock Text="Search" Style="{StaticResource Label}" />
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,12,0" AutomationProperties.Name="Search games" />
                <ComboBox ItemsSource="{Binding StoreFilters}" SelectedItem="{Binding StoreFilter}" Width="120" Margin="0,0,6,0" AutomationProperties.Name="Store filter" />
                <ComboBox ItemsSource="{Binding EngineFilters}" SelectedItem="{Binding EngineFilter}" Width="120" Margin="0,0,6,0" AutomationProperties.Name="Engine filter" />
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="200" Margin="0,0,10,0" AutomationProperties.Name="Status filter" />
                <CheckBox Content="My own choices" IsChecked="{Binding OnlyCustom}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox Content="Changes waiting" IsChecked="{Binding OnlyPending}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Content="Select shown" Click="SelectShown_Click" Margin="0,0,6,0" />
                <Button Content="Clear selection" Click="ClearSelection_Click" Margin="0,0,10,0" />
                <TextBlock x:Name="ShownText" Style="{StaticResource Label}" />
            </WrapPanel>
        </StackPanel>

        <!-- Game list -->
        <ListBox Grid.Row="1" x:Name="GameList" ItemsSource="{Binding Games}" Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 KeyboardNavigation.TabNavigation="Continue">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="0,0,0,6" /></ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="220" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="0"
                                          AutomationProperties.Name="{Binding Name, StringFormat=Select {0}}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Running now" Style="{StaticResource ChipText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding EngineText}" Style="{StaticResource Secondary}" />
                                        <TextBlock Text="  ·  " Style="{StaticResource Secondary}" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="  ⚠" Foreground="{DynamicResource SystemFillColorCautionBrush}" ToolTip="{Binding WarningText}"
                                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="-6,2,0,0">
                                        <ItemsControl ItemsSource="{Binding Links}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Link}" Tag="{Binding Url}" ToolTip="{Binding Url}" Click="Link_Click" Content="{Binding Label}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Style="{StaticResource Link}" Content="Open settings folder" Click="OpenFolder_Click" Tag="{Binding}" Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Link}" Content="Add a rule" Click="AddRule_Click" Tag="{Binding}" Visibility="{Binding CanAddRule, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Link}" Content="Launch once, then rescan" Click="Launch_Click" Tag="{Binding}" Visibility="{Binding CanLaunch, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                    <Slider Value="{Binding Step, Mode=TwoWay}" IsEnabled="{Binding IsSupported}"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Quality step for {0}}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0" ToolTip="{Binding RecDetails}">
                                        <TextBlock Text="{Binding RecText}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AtRecommended}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Style="{StaticResource Chip}" Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="6,0,0,0" Padding="6,0">
                                            <TextBlock Text="{Binding BasisChip}" Style="{StaticResource ChipText}" FontSize="10" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Background="{DynamicResource AccentFillColorSecondaryBrush}" Margin="4,0,0,0" Padding="6,0"
                                                Visibility="{Binding HasMeasured, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="measured" FontSize="10" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                    <StackPanel VerticalAlignment="Center" Width="74">
                                        <TextBlock Text="{Binding StepLabel}" />
                                        <TextBlock Text="{Binding StepSource}" Style="{StaticResource Secondary}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding StepSource}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                                        <Border Style="{StaticResource Chip}" Background="{DynamicResource AccentFillColorSecondaryBrush}">
                                            <TextBlock Text="custom" Style="{StaticResource ChipText}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                        <Button Style="{StaticResource Link}" Content="↺" ToolTip="Back to the profile's quality" Click="ResetRow_Click" Tag="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton Content="Settings" IsChecked="{Binding IsExpanded}" Margin="0,0,6,0" Padding="10,6" IsEnabled="{Binding IsSupported}" />
                                    <Button Content="Preview" Click="PreviewRow_Click" Tag="{Binding}" Margin="0,0,6,0" IsEnabled="{Binding IsSupported}" />
                                    <Button Content="Apply" Style="{DynamicResource AccentButtonStyle}" Click="ApplyRow_Click" Tag="{Binding}" IsEnabled="{Binding CanOptimize}" />
                                </StackPanel>
                            </Grid>

                            <!-- Live actions: boost, graphics chip, can this PC run it -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Live.RowBoostText}" Click="BoostRow_Click" Tag="{Binding}" Margin="0,0,6,0"
                                            IsEnabled="{Binding CanBoost}" ToolTip="{Binding BoostTip}" />
                                    <Button Content="{Binding Live.UseGpuText}" Click="UseGpu_Click" Tag="{Binding}" Margin="0,0,6,0"
                                            Visibility="{Binding CanFixGpu, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Tell Windows to run this game on your dedicated graphics card. Takes effect the next time the game starts." />
                                    <Button Content="Can this PC run it?" Click="SpecCheck_Click" Tag="{Binding}" Margin="0,0,6,0"
                                            IsEnabled="{Binding HasSpecCheck}" ToolTip="{Binding SpecCheckTip}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding GpuText}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Visibility="{Binding ShowGpuText, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <!-- Per-game settings -->
                            <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Style="{StaticResource InnerCard}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding EffectiveText}" Style="{StaticResource Secondary}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding NotControlledText}" Style="{StaticResource Secondary}" Margin="0,0,0,8"
                                               Visibility="{Binding HasNotControlled, Converter={StaticResource BoolToVis}}" />
                                    <WrapPanel>
                                        <TextBlock Text="Profile" Style="{StaticResource Label}" />
                                        <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedValuePath="Key" SelectedValue="{Binding ProfileKey}" Width="170" Margin="0,0,16,4" />
                                        <TextBlock Text="Frame cap" Style="{StaticResource Label}" />
                                        <ComboBox ItemsSource="{Binding FpsChoices}" SelectedValuePath="Key" SelectedValue="{Binding FpsKey}" Width="270" Margin="0,0,6,4"
                                                  ToolTip="A frame limiter caps how fast the game renders. It does not make the hardware reach that rate, and it does not replace VSync." />
                                        <TextBox Text="{Binding CustomFps, UpdateSourceTrigger=LostFocus}" Width="60" Margin="0,0,4,4" ToolTip="Custom cap in fps (10 to 1000)"
                                                 AutomationProperties.Name="Custom frame cap" />
                                        <TextBlock Text="fps" Style="{StaticResource Label}" Margin="0,0,16,0" />
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBlock Text="Display" Style="{StaticResource Label}" />
                                        <ComboBox ItemsSource="{Binding DisplayChoices}" SelectedValuePath="Key" SelectedValue="{Binding DisplayKey}" Width="280" Margin="0,0,16,4" />
                                        <TextBlock Text="Resolution" Style="{StaticResource Label}" />
                                        <ComboBox ItemsSource="{Binding ResolutionChoices}" SelectedValuePath="Key" SelectedValue="{Binding ResolutionKey}" Width="180" Margin="0,0,16,4" />
                                        <TextBlock Text="Display mode" Style="{StaticResource Label}" />
                                        <ComboBox ItemsSource="{Binding DisplayModeChoices}" SelectedValuePath="Key" SelectedValue="{Binding DisplayModeKey}" Width="180" Margin="0,0,16,4" />
                                        <TextBlock Text="VSync" Style="{StaticResource Label}" />
                                        <ComboBox ItemsSource="{Binding VSyncChoices}" SelectedValuePath="Key" SelectedValue="{Binding VSyncKey}" Width="140" Margin="0,0,0,4" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <TextBlock Text="Keep as the game has it:" Style="{StaticResource Label}" />
                                        <CheckBox Content="Resolution" IsChecked="{Binding KeepResolution}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <CheckBox Content="Display mode" IsChecked="{Binding KeepDisplayMode}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <CheckBox Content="VSync" IsChecked="{Binding KeepVSync}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <CheckBox Content="Frame cap" IsChecked="{Binding KeepFps}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <CheckBox Content="Render scale" IsChecked="{Binding KeepRenderScale}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <CheckBox Content="Textures" IsChecked="{Binding KeepTexture}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <CheckBox Content="Other quality" IsChecked="{Binding KeepQuality}" VerticalAlignment="Center" />
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasExclusions, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding ExcludedText}" Style="{StaticResource Secondary}" MaxWidth="760" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource Link}" Content="Stop keeping these" Click="ClearKept_Click" Tag="{Binding}" />
                                    </StackPanel>
                                    <WrapPanel Margin="0,6,0,0" Visibility="{Binding CanLinkAppId, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Steam app id for requirement lookups" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding SteamAppId, UpdateSourceTrigger=LostFocus}" Width="90" Margin="0,0,8,0"
                                                 ToolTip="Only a number you look up yourself. The tool never guesses an id from the name." />
                                    </WrapPanel>
                                    <DockPanel Margin="0,6,0,0">
                                        <Button DockPanel.Dock="Right" Content="Reset this game's choices" Click="ResetChoices_Click" Tag="{Binding}" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding AppIdSource}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="PreviewSelected_Click" Margin="0,0,8,0">
                    <TextBlock Text="{Binding SelectedButtonsText, StringFormat=Preview {0}}" />
                </Button>
                <Button Click="ApplySelected_Click" Margin="0,0,16,0">
                    <TextBlock Text="{Binding SelectedButtonsText, StringFormat=Optimize {0}}" />
                </Button>
                <Button Style="{DynamicResource AccentButtonStyle}" Click="OptimizeAll_Click" Padding="18,8"
                        ToolTip="Every game the tool can change, whatever the search and filters show. A preview comes first.">
                    <TextBlock Text="{Binding OptimizeAllText}" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
