<UserControl x:Class="OptiGame.App.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OptiGame.App.Controls"
             xmlns:vm="clr-namespace:OptiGame.App.ViewModels"
             PreviewKeyDown="Page_PreviewKeyDown">
    <UserControl.Resources>
        <c:InvertBool x:Key="InvertBool" />
        <c:InvertBoolToVisConverter x:Key="InvertBoolToVis" />

        <!-- one game in the list: art tile, name, store and engine, status dot, step -->
        <DataTemplate x:Key="GameRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="4" ClipToBounds="True" Background="{Binding Tile}">
                    <Grid>
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowSmallInitials, Converter={StaticResource BoolToVis}}" />
                        <Image Source="{Binding SmallIcon}" Stretch="{Binding SmallIconStretch}" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasSmallIcon, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding EngineText}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding StepSummary}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                        <Border Style="{StaticResource Chip}" Background="{DynamicResource AccentFillColorSecondaryBrush}" Padding="6,0" Margin="0,0,4,0"
                                Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="custom" FontSize="10" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <Border Style="{StaticResource Chip}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" Padding="6,0"
                                Visibility="{Binding ShowRunningBanner, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Running" FontSize="10" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <!-- batch tick box: shown on hover, or on every row once something is ticked -->
                <CheckBox x:Name="Cb" IsChecked="{Binding IsSelected}" Visibility="Collapsed" MinWidth="0" Margin="-6,-8,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                          Panel.ZIndex="2" AutomationProperties.Name="{Binding Name, StringFormat=Select {0}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Cb" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Cb" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.AnySelected, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                    <Setter TargetName="Cb" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="36,24,36,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title, filter segments, search, actions -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Games" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" MaxWidth="250" ToolTip="{Binding Status}" />
            </StackPanel>
            <ListBox Grid.Column="1" Style="{StaticResource Segmented}" SelectedIndex="{Binding FilterIndex, Mode=TwoWay}" VerticalAlignment="Bottom" Margin="16,0,0,2"
                     AutomationProperties.Name="Which games to show">
                <ListBoxItem Content="{Binding CanChangeLabel}" />
                <ListBoxItem Content="{Binding SkippedLabel}" />
                <ListBoxItem Content="{Binding AllLabel}" />
            </ListBox>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,2">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,8,0" AutomationProperties.Name="Search games"
                         ToolTip="Search games" />
                <Button Style="{StaticResource GhostButton}" Content="&#xE72C;" FontFamily="{StaticResource Icons}" Click="Rescan_Click" ToolTip="Rescan (F5)" AutomationProperties.Name="Rescan" />
                <Button Style="{StaticResource GhostButton}" Content="&#xE8F4;" FontFamily="{StaticResource Icons}" Click="AddFolder_Click" ToolTip="Add a game folder" AutomationProperties.Name="Add a game folder" />
                <Button Style="{StaticResource GhostButton}" Content="&#xE712;" FontFamily="{StaticResource Icons}" Click="More_Click" ToolTip="More" AutomationProperties.Name="More">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Optimize all supported games…" Click="OptimizeAll_Click" />
                            <MenuItem Header="Select every game shown" Click="SelectShown_Click" />
                            <MenuItem Header="Clear selection" Click="ClearSelection_Click" />
                            <Separator />
                            <MenuItem Header="Manage added folders…" Click="ManageFolders_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Defaults for all games: one line, expands -->
        <Expander Grid.Row="1" Margin="0,12,0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9E9;" Style="{StaticResource IconText}" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Defaults for all games" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DefaultsSummary}" Style="{StaticResource Secondary}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Expander.Header>
            <Grid Margin="4,6,4,4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Quality for all games" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding GlobalLabel}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,24,0">
                    <Slider x:Name="GlobalSlider" Minimum="-3" Maximum="3" Value="{Binding GlobalOffset, Mode=TwoWay}"
                            AutomationProperties.Name="Quality offset for all games" IsEnabled="{Binding Busy, Converter={StaticResource InvertBool}}" />
                    <Canvas x:Name="GlobalTicks" Height="22" ClipToBounds="False" />
                </StackPanel>
                <Button Grid.Column="2" Content="Back to recommended" Click="UseRecommended_Click" VerticalAlignment="Center" />
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
                    <TextBlock Text="Default profile" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding DefaultProfileChoices}" SelectedValuePath="Key" SelectedValue="{Binding DefaultProfile}"
                              Width="170" Margin="0,0,8,0" AutomationProperties.Name="Default profile" ToolTip="{Binding DefaultProfileText}" />
                    <Button Content="Profiles…" Click="Profiles_Click" Margin="0,0,24,0" />
                    <TextBlock Text="Gaming display" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding GamingDisplayChoices}" SelectedValuePath="Key" SelectedValue="{Binding GamingDisplay}"
                              Width="300" AutomationProperties.Name="Gaming display" ToolTip="Used for resolution and the automatic frame cap. Windows display settings are never changed." />
                </WrapPanel>
            </Grid>
        </Expander>

        <!-- Master (list) and detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="370" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <!-- ============ list ============ -->
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,6">
                    <ComboBox ItemsSource="{Binding StoreFilters}" SelectedItem="{Binding StoreFilter}" Width="112" Margin="0,0,6,4" AutomationProperties.Name="Store filter" />
                    <ComboBox ItemsSource="{Binding EngineFilters}" SelectedItem="{Binding EngineFilter}" Width="128" Margin="0,0,6,4" AutomationProperties.Name="Engine filter" />
                    <ToggleButton Content="Waiting" IsChecked="{Binding OnlyPending}" Margin="0,0,6,4" ToolTip="Only games with changes waiting" />
                    <ToggleButton Content="Mine" IsChecked="{Binding OnlyCustom}" Margin="0,0,0,4" ToolTip="Only games where you made your own choices" />
                </WrapPanel>
                <ListBox Grid.Row="1" x:Name="GameList" ItemsSource="{Binding Games}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource GameRowItem}" ItemTemplate="{StaticResource GameRowTemplate}"
                         VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Games" />
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8" Visibility="{Binding BatchVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Click="PreviewSelected_Click" Margin="0,0,8,0"><TextBlock Text="{Binding SelectedCount, StringFormat=Preview {0}}" /></Button>
                                <Button Style="{DynamicResource AccentButtonStyle}" Click="ApplySelected_Click"><TextBlock Text="{Binding SelectedCount, StringFormat=Optimize {0}}" /></Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ShownText" Style="{StaticResource Secondary}" />
                </StackPanel>
                <!-- nothing matches -->
                <Border Grid.Row="1" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Stretch">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=GameList}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No games match" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Nothing fits this search and filter." Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,4,0,10" />
                        <Button Content="Clear filters" Click="ClearFilters_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ detail ============ -->
            <Grid Grid.Column="2" DataContext="{Binding Selected}" Visibility="{Binding DataContext.HasSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">

                        <!-- hero: art, name, links and live actions -->
                        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <Border Height="130" Background="{Binding Tile}">
                                    <Grid>
                                        <TextBlock Text="{Binding Initials}" Foreground="#38FFFFFF" FontSize="64" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0"
                                                   Visibility="{Binding ShowInitials, Converter={StaticResource BoolToVis}}" />
                                        <Image Source="{Binding Art}" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasArt, Converter={StaticResource BoolToVis}}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Stretch" Value="UniformToFill" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIcon}" Value="True">
                                                            <Setter Property="Stretch" Value="Uniform" />
                                                            <Setter Property="StretchDirection" Value="DownOnly" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="16,12,16,14">
                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding EngineText}" Style="{StaticResource Secondary}" />
                                        <TextBlock Text="  ⚠" Foreground="{DynamicResource SystemFillColorCautionBrush}" ToolTip="{Binding WarningText}"
                                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="-6,2,0,0">
                                        <ItemsControl ItemsSource="{Binding Links}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><Button Style="{StaticResource Link}" Tag="{Binding Url}" ToolTip="{Binding Url}" Click="Link_Click" Content="{Binding Label}" /></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Style="{StaticResource Link}" Content="Open settings folder" Click="OpenFolder_Click" Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="{Binding Live.RowBoostText}" Click="BoostRow_Click" Margin="0,0,6,6" IsEnabled="{Binding CanBoost}" ToolTip="{Binding BoostTip}" />
                                        <Button Content="{Binding Live.UseGpuText}" Click="UseGpu_Click" Margin="0,0,6,6" Visibility="{Binding CanFixGpu, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Tell Windows to run this game on your dedicated graphics card. Takes effect the next time the game starts." />
                                        <Button Content="Can this PC run it?" Click="SpecCheck_Click" Margin="0,0,6,6" IsEnabled="{Binding HasSpecCheck}" ToolTip="{Binding SpecCheckTip}" />
                                        <Button Content="Cover and icon…" Click="ChangeArt_Click" Style="{StaticResource GhostButton}" Margin="0,0,6,6" ToolTip="{Binding ArtSource, StringFormat=Cover from {0}}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Choose cover…" Click="ArtChoose_Click" />
                                                    <MenuItem Header="Reset cover and fetch again" Click="ArtRefetch_Click" />
                                                    <Separator />
                                                    <MenuItem Header="Choose small icon…" Click="IconChoose_Click" />
                                                    <MenuItem Header="Reset small icon" Click="IconReset_Click" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding GpuText}" Style="{StaticResource Secondary}" Visibility="{Binding ShowGpuText, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- running: why Apply is blocked -->
                        <Border Margin="0,8,0,0" CornerRadius="4" Padding="12,9" BorderThickness="1" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Visibility="{Binding ShowRunningBanner, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="16" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding RunningText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- skipped: why, and what to do -->
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="{Binding IsSkipped, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Skipped" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Secondary}" FontSize="13" Margin="0,3,0,4" />
                                <TextBlock Text="{Binding SkipDetailText}" Style="{StaticResource Secondary}" FontSize="13" Margin="0,0,0,10" />
                                <WrapPanel>
                                    <Button Content="Open settings folder" Click="OpenFolder_Click" Margin="0,0,6,0" Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Add a rule" Click="AddRule_Click" Margin="0,0,6,0" Visibility="{Binding CanAddRule, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Launch once, then rescan" Click="Launch_Click" Visibility="{Binding CanLaunch, Converter={StaticResource BoolToVis}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- quality -->
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="{Binding IsSkipped, Converter={StaticResource InvertBoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Quality" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding QualityNote}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource Link}" Content="↺ Back to recommended" Click="ResetRow_Click" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                                <ListBox Style="{StaticResource Segmented}" ItemsSource="{x:Static c:Steps.Names}" SelectedIndex="{Binding Step, Mode=TwoWay}" IsEnabled="{Binding IsSupported}"
                                         AutomationProperties.Name="Quality step" />
                                <ItemsControl ItemsSource="{Binding RecMarkers}" Margin="2,2,2,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" FontSize="10" TextAlignment="Center" TextTrimming="None" HorizontalAlignment="Stretch" TextWrapping="NoWrap" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding RecommendedLine}" Style="{StaticResource Secondary}" Margin="0,6,0,0" ToolTip="{Binding RecDetails}" />
                            </StackPanel>
                        </Border>

                        <!-- changes (the preview, inline) -->
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="{Binding IsSkipped, Converter={StaticResource InvertBoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding ChangesTitle}" FontWeight="SemiBold" />
                                    <TextBlock Text="Each file and registry value is backed up first" Style="{StaticResource Secondary}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding ChangedFile}" Style="{StaticResource Mono}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,4" />
                                <ItemsControl ItemsSource="{Binding ChangeItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding Included}" IsEnabled="{Binding CanToggle}" ToolTip="{Binding Tip}" MinWidth="0" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding Text}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Mono}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="2,0,8,0" />
                                                <Button Grid.Column="2" Style="{StaticResource Link}" Content="{Binding KeepText}" Click="AlwaysKeep_Click"
                                                        ToolTip="Never change this setting for this game (saved; undo it here)" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding NoChangesText}" FontSize="13" Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasChangeItems}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding NotControlledText}" Style="{StaticResource Secondary}" Margin="0,8,0,0" Visibility="{Binding HasNotControlled, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- advice: suggestions only, never written by Apply -->
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="{Binding ShowAdviceCard, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Suggestions" FontWeight="SemiBold" />
                                    <TextBlock Text="Advice only. Apply never changes these" Style="{StaticResource Secondary}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding QualityLine}" Style="{StaticResource Secondary}" FontSize="13" Margin="0,4,0,4" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding AdviceLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding Change}" Style="{StaticResource Mono}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding AdviceNotes}" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding HasAdviceNotes, Converter={StaticResource BoolToVis}}" />
                                <Expander Header="Sources" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding EvidenceLines}" Margin="4,4,4,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Source}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" />
                                                    <Button Style="{StaticResource Link}" Content="{Binding LinkText}" Click="OpenEvidence_Click"
                                                            Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- where the settings live: looked up only when asked -->
                        <Expander Header="Where its settings are" Margin="0,4,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Margin="4,4,4,2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Look for them" Click="FindLocations_Click" IsEnabled="{Binding CanLocate}" />
                                    <TextBlock Text="{Binding LocationStatus}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding CandidateLines}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                                                <TextBlock FontSize="12" Style="{StaticResource Secondary}" TextWrapping="Wrap">
                                                    <Run Text="{Binding Confidence, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Format, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Evidence}" FontSize="12" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding DiagnosticLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" FontSize="12" Style="{StaticResource Secondary}" TextWrapping="Wrap" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- rule draft from two snapshots: a preview first, saved inactive -->
                        <Expander Header="Draft a rule from snapshots" Margin="0,4,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Visibility="{Binding IsSkipped, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="4,4,4,2">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Secondary}" FontSize="12"
                                           Text="Take a snapshot of the settings file, change one setting in the game, take another (optigame-cli rule snapshot). Pick both here. The draft only uses what changed, at the step you name." />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="Before" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,4" />
                                    <TextBox Grid.Column="1" Text="{Binding DraftBefore, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,4" />
                                    <Button Grid.Column="2" Content="Choose…" Click="ChooseBefore_Click" Margin="0,0,0,4" />
                                    <TextBlock Grid.Row="1" Text="After" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DraftAfter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <Button Grid.Row="1" Grid.Column="2" Content="Choose…" Click="ChooseAfter_Click" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="After was taken at" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{x:Static vm:GameRow.StepNames}" SelectedIndex="{Binding DraftStep, Mode=TwoWay}" MinWidth="130" />
                                    <TextBlock Text="Keys (optional)" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="14,0,8,0" />
                                    <TextBox Text="{Binding DraftKeys, UpdateSourceTrigger=PropertyChanged}" MinWidth="160"
                                             ToolTip="Only needed when more than one setting changed. Separate keys with commas." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Preview draft" Click="PreviewDraft_Click" IsEnabled="{Binding CanPreviewDraft}" />
                                    <Button Content="Save as inactive draft" Click="SaveDraft_Click" IsEnabled="{Binding CanSaveDraft}" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding DraftStatus}" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <StackPanel Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding DraftStepText}" FontSize="13" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding DraftLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Mono}" />
                                                    <TextBlock Text="{Binding Slots}" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding DraftNotes}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" FontSize="12" Style="{StaticResource Secondary}" TextWrapping="Wrap" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- per-game settings, collapsed away unless wanted -->
                        <Expander Header="Frame rate and display" IsExpanded="True" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Visibility="{Binding IsSkipped, Converter={StaticResource InvertBoolToVis}}">
                            <StackPanel Margin="4,4,4,2">
                                <TextBlock Text="{Binding EffectiveText}" Style="{StaticResource Secondary}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,12,8"><TextBlock Text="Profile" Style="{StaticResource Secondary}" />
                                        <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedValuePath="Key" SelectedValue="{Binding ProfileKey}" Width="170" /></StackPanel>
                                    <StackPanel Margin="0,0,12,8"><TextBlock Text="Frame cap" Style="{StaticResource Secondary}" />
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox ItemsSource="{Binding FpsChoices}" SelectedValuePath="Key" SelectedValue="{Binding FpsKey}" Width="240"
                                                      ToolTip="A frame limiter caps how fast the game renders. It does not make the hardware reach that rate, and it does not replace VSync." />
                                            <TextBox Text="{Binding CustomFps, UpdateSourceTrigger=LostFocus}" Width="60" Margin="6,0,4,0" ToolTip="Custom cap in fps (10 to 1000)" AutomationProperties.Name="Custom frame cap" />
                                            <TextBlock Text="fps" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
                                        </StackPanel></StackPanel>
                                </WrapPanel>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,12,8"><TextBlock Text="Display" Style="{StaticResource Secondary}" />
                                        <ComboBox ItemsSource="{Binding DisplayChoices}" SelectedValuePath="Key" SelectedValue="{Binding DisplayKey}" Width="250" /></StackPanel>
                                    <StackPanel Margin="0,0,12,8"><TextBlock Text="Resolution" Style="{StaticResource Secondary}" />
                                        <ComboBox ItemsSource="{Binding ResolutionChoices}" SelectedValuePath="Key" SelectedValue="{Binding ResolutionKey}" Width="180" /></StackPanel>
                                    <StackPanel Margin="0,0,12,8"><TextBlock Text="Display mode" Style="{StaticResource Secondary}" />
                                        <ComboBox ItemsSource="{Binding DisplayModeChoices}" SelectedValuePath="Key" SelectedValue="{Binding DisplayModeKey}" Width="190" /></StackPanel>
                                    <StackPanel Margin="0,0,0,8"><TextBlock Text="VSync" Style="{StaticResource Secondary}" />
                                        <ComboBox ItemsSource="{Binding VSyncChoices}" SelectedValuePath="Key" SelectedValue="{Binding VSyncKey}" Width="140" /></StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Keep as the game has it" Margin="0,4,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Visibility="{Binding IsSkipped, Converter={StaticResource InvertBoolToVis}}">
                            <StackPanel Margin="4,4,4,2">
                                <WrapPanel>
                                    <CheckBox Content="Resolution" IsChecked="{Binding KeepResolution}" Margin="0,0,14,6" />
                                    <CheckBox Content="Display mode" IsChecked="{Binding KeepDisplayMode}" Margin="0,0,14,6" />
                                    <CheckBox Content="VSync" IsChecked="{Binding KeepVSync}" Margin="0,0,14,6" />
                                    <CheckBox Content="Frame cap" IsChecked="{Binding KeepFps}" Margin="0,0,14,6" />
                                    <CheckBox Content="Render scale" IsChecked="{Binding KeepRenderScale}" Margin="0,0,14,6" />
                                    <CheckBox Content="Textures" IsChecked="{Binding KeepTexture}" Margin="0,0,14,6" />
                                    <CheckBox Content="Other quality" IsChecked="{Binding KeepQuality}" Margin="0,0,0,6" />
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasExclusions, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ExcludedText}" Style="{StaticResource Secondary}" MaxWidth="560" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource Link}" Content="Stop keeping these" Click="ClearKept_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Lookups" Margin="0,4,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Margin="4,4,4,2">
                                <StackPanel Orientation="Horizontal" Visibility="{Binding CanLinkAppId, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                    <TextBlock Text="Steam app id for requirement lookups" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding SteamAppId, UpdateSourceTrigger=LostFocus}" Width="100"
                                             ToolTip="Only a number you look up yourself. The tool never guesses an id from the name." />
                                </StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Reset this game's choices" Click="ResetChoices_Click" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding AppIdSource}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- sticky bar: last run and Undo, then the one accent button -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,8,10,0" Visibility="{Binding IsSkipped, Converter={StaticResource InvertBoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Last run" Style="{StaticResource Secondary}" />
                            <TextBlock Text="{Binding LastRunText}" TextTrimming="CharacterEllipsis" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Undo" Click="Undo_Click" IsEnabled="{Binding CanUndo}" Margin="8,0" ToolTip="Open the restore preview for the last run" />
                        <Button Grid.Column="2" Content="{Binding ApplyText}" Style="{DynamicResource AccentButtonStyle}" Click="ApplyRow_Click" IsEnabled="{Binding CanApply}" MinWidth="140" ToolTip="Ctrl+Enter" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
