<UserControl x:Class="OptiGame.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OptiGame.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,32" MaxWidth="1040">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

            <TextBlock Text="Automation" Style="{StaticResource SectionTitle}" />
            <c:SettingRow Title="Boost automatically when a game starts" Description="Trims memory, moves background apps to efficiency mode and raises the game to High. It never closes apps by itself and never changes the power plan. Everything is put back when the game closes." IsOn="{Binding Settings.AutoBoost, Mode=TwoWay}" />
            <c:SettingRow Title="Re-open apps after the game closes" Description="Apps you closed from OptiGame+ are launched again when the game exits." IsOn="{Binding Settings.ReopenAfterGame, Mode=TwoWay}" />
            <c:SettingRow Title="Force-close apps that ignore the request" Description="Off by default. Apps are asked politely first; turning this on ends the ones that do not respond, which can lose unsaved work." IsOn="{Binding Settings.ForceClose, Mode=TwoWay}" />
            <c:SettingRow Title="Treat fullscreen apps as games" Description="Also boost for unknown fullscreen programs (never browsers or video players). Off by default." IsOn="{Binding Settings.TreatFullscreenAsGame, Mode=TwoWay}" />

            <TextBlock Text="Performance" Style="{StaticResource SectionTitle}" />
            <c:SettingRow Title="Trim memory of background apps" Description="Moves idle pages out of RAM so the game has more to work with. Fully reversible: apps page them back in." IsOn="{Binding Settings.TrimMemory, Mode=TwoWay}" />
            <c:SettingRow Title="Efficiency mode for background apps" Description="Pushes background apps onto your efficiency cores at lower priority, then restores them afterwards." IsOn="{Binding Settings.ThrottleBackground, Mode=TwoWay}" />
            <c:SettingRow Title="Raise the game's priority" Description="Sets the game to High (never Realtime) while it runs." IsOn="{Binding Settings.RaiseGamePriority, Mode=TwoWay}" />
            <c:SettingRow Title="Allow the High performance power plan" Description="Used only when you press Boost or accept the suggestion, never by auto-boost. Switched back when the game closes." IsOn="{Binding Settings.SwitchPowerPlan, Mode=TwoWay}" />
            <c:SettingRow Title="Deep memory clean (standby list)" Description="{Binding AdminText}" IsOn="{Binding Settings.PurgeStandby, Mode=TwoWay}" SwitchEnabled="{Binding IsAdmin}" />

            <TextBlock Text="App" Style="{StaticResource SectionTitle}" />
            <c:SettingRow Title="Keep running in the tray when closed" Description="Needed for automatic boosting while you play." IsOn="{Binding Settings.KeepInTray, Mode=TwoWay}" />
            <c:SettingRow Title="Show notifications" Description="A Windows notification when a game is boosted or restored." IsOn="{Binding Settings.Notifications, Mode=TwoWay}" />
            <c:SettingRow Title="Start with Windows" Description="Launches hidden in the tray when you sign in. Off by default." IsOn="{Binding StartWithWindows, Mode=TwoWay}" />

            <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="16,12">
                <Border.Visibility>
                    <Binding Path="IsAdmin"><Binding.Converter><c:InvertBoolToVisConverter /></Binding.Converter></Binding>
                </Border.Visibility>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Administrator mode" />
                        <TextBlock Text="Only needed for the deep memory clean. OptiGame+ works fully without it." Style="{StaticResource Secondary}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Restart as administrator" Click="RestartAdmin_Click" />
                </Grid>
            </Border>

            <TextBlock Text="Your laptop" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="16,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding VendorHeadline}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding VendorTipText}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding VendorOpenText}" Click="OpenVendor_Click" Visibility="{Binding HasVendor, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding VendorApps}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Source, StringFormat='  ·  {0}'}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Open" Style="{StaticResource GhostButton}" Click="OpenVendorApp_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Choose your vendor app…" Click="ChooseVendor_Click" />
                        <Button Content="Forget my choice" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="ForgetVendor_Click" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0"
                               Text="OptiGame+ only opens the app: there is no public interface to drive its fan or performance modes. The table of brands is data\vendors.json (add your own in %LOCALAPPDATA%\GameOpt\vendors.json)." />
                </StackPanel>
            </Border>

            <TextBlock Text="Game Spec Check" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SpecCheckText}" TextWrapping="Wrap" />
                        <TextBlock Text="Powers the “Can this PC run it?” button on each game. It is a separate tool: OptiGame+ starts it and opens the game's page." Style="{StaticResource Secondary}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Choose…" Click="ChooseSpecCheck_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />
            <c:SettingRow Title="Check for updates automatically" Description="Once a day OptiGame+ asks GitHub for the latest release. Nothing about this PC is sent." IsOn="{Binding Settings.CheckForUpdates, Mode=TwoWay}" />
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionText}" />
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Check now" Click="CheckUpdate_Click" IsEnabled="{Binding CanCheckUpdate}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="{Binding InstallUpdateText}" Click="InstallUpdate_Click" Style="{DynamicResource AccentButtonStyle}" VerticalAlignment="Center"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanCheckUpdate}" />
                </Grid>
            </Border>

            <TextBlock Text="Game optimizer tools" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="History, benchmarks, profiles, rules and moving your choices between PCs." Style="{StaticResource Secondary}" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Content="History and restore…" Click="History_Click" Margin="0,0,8,8" />
                        <Button Content="Benchmarks…" Click="Benchmarks_Click" Margin="0,0,8,8" />
                        <Button Content="Profiles…" Click="Profiles_Click" Margin="0,0,8,8" />
                        <Button Content="Rule wizard…" Click="Wizard_Click" Margin="0,0,8,8" />
                        <Button Content="Check rule files…" Click="ValidateRules_Click" Margin="0,0,8,8" />
                        <Button Content="Export preferences…" Click="Export_Click" Margin="0,0,8,8" />
                        <Button Content="Import preferences…" Click="Import_Click" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="What OptiGame+ learned" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="16,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding LearnedSummary}" TextWrapping="Wrap" />
                            <TextBlock Text="Stored only on this PC. Un-tick a suggested app twice and it is kept; close a reviewed app twice and it becomes a suggestion." Style="{StaticResource Secondary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Reset learning" Click="ResetLearning_Click" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding KeepItems}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Remove" Style="{StaticResource GhostButton}" Click="RemoveKeep_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="Your system" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="{Binding ModelLine}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Profile.CpuSummary}" Style="{StaticResource Secondary}" Margin="0,4,0,0" FontSize="13" />
                    <TextBlock Text="{Binding RamLine}" Style="{StaticResource Secondary}" FontSize="13" />
                    <TextBlock Text="{Binding GpuLine}" Style="{StaticResource Secondary}" FontSize="13" />
                    <TextBlock Text="{Binding TuneNote}" Style="{StaticResource Secondary}" FontSize="13" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Secondary}" Margin="2,18,0,0"
                       Text="OptiGame+ is a personal tool written with AI, for noncommercial use only (PolyForm Noncommercial 1.0.0). See LICENSE, NOTICE and CREDITS.md." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
