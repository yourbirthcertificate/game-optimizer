<Window x:Class="OptiGame.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiGame+" Width="1240" Height="840" MinWidth="980" MinHeight="640"
        Background="Transparent" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Navigation pane ============ -->
        <DockPanel Grid.Column="0" Margin="0,10,0,14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,10,0,18">
                <Image Source="pack://application:,,,/Assets/app-256.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="OptiGame+" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="22,0,14,0">
                <TextBlock Text="Tuned for" Style="{StaticResource Secondary}" />
                <TextBlock Text="{Binding ProfileLine}" Style="{StaticResource Secondary}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
            <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                     SelectedIndex="0" SelectionChanged="Nav_Changed" Focusable="True">
                <ListBoxItem Tag="&#xE80F;" Content="Dashboard" AutomationProperties.Name="Dashboard" />
                <ListBoxItem Tag="&#xE71D;" Content="Apps" AutomationProperties.Name="Apps" />
                <ListBoxItem Tag="&#xE7FC;" Content="Games" AutomationProperties.Name="Games" />
                <ListBoxItem Tag="&#xE713;" Content="Settings" AutomationProperties.Name="Settings" />
            </ListBox>
        </DockPanel>

        <!-- ============ Content ============ -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- InfoBar -->
                <Border Grid.Row="0" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" Margin="36,20,36,0"
                        CornerRadius="4" Padding="14,10" BorderThickness="1"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="16" Foreground="{DynamicResource SystemFillColorAttentionBrush}" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="&#xE711;" FontFamily="{StaticResource Icons}" Style="{StaticResource GhostButton}" Padding="8,4" Click="DismissMessage_Click" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" />
                    </Grid>
                </Border>

                <Grid x:Name="Pages" Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</Window>
