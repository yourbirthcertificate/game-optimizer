<UserControl x:Class="OptiGame.App.Controls.SettingRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource Card}" Margin="0,0,0,4" Padding="16,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Text="{Binding Title, ElementName=Root}" />
                <TextBlock Text="{Binding Description, ElementName=Root}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding OnOffText, ElementName=Root}" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" Visibility="Collapsed" />
            <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding IsOn, ElementName=Root, Mode=TwoWay}"
                          IsEnabled="{Binding SwitchEnabled, ElementName=Root}" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
