<Window x:Class="GameOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameOptimizer.App"
        Title="GameOptimizer" Width="1100" Height="760" MinWidth="820" MinHeight="520"
        Background="{StaticResource Bg}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <local:InvertBool x:Key="InvertBool"/>
    </Window.Resources>
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="GameOptimizer" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding HardwareText}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Global slider -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="All games" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding GlobalLabel}" Foreground="{StaticResource Accent}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,24,0">
                    <Slider x:Name="GlobalSlider" Minimum="-3" Maximum="3" Value="{Binding GlobalOffset, Mode=TwoWay}"
                            IsEnabled="{Binding Busy, Converter={StaticResource InvertBool}}"/>
                    <Canvas x:Name="GlobalTicks" Height="34" ClipToBounds="False"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Content="Back to recommended" Click="UseRecommended_Click"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding HintText}" Foreground="{StaticResource Muted}"
                           Margin="0,6,0,0"/>
            </Grid>
        </Border>

        <!-- Game list -->
        <ListBox Grid.Row="2" x:Name="GameList" ItemsSource="{Binding Games}" Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter Margin="0,0,0,6"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="220"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding EngineText}" Foreground="{StaticResource Muted}"/>
                                    <TextBlock Text="  ·  " Foreground="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="  ⚠" Foreground="{StaticResource Warn}" ToolTip="See the preview for a warning"
                                               Visibility="{Binding HasWarning, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                <Slider Value="{Binding Step, Mode=TwoWay}" IsEnabled="{Binding IsSupported}"/>
                                <TextBlock Text="{Binding RecText}" ToolTip="{Binding RecReason}" FontSize="11" Margin="0,2,0,0"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AtRecommended}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                <TextBlock Text="{Binding StepLabel}" Width="68" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustom, Converter={StaticResource Vis}}">
                                    <Border Background="#22324F" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="custom" Foreground="{StaticResource Custom}" FontSize="11"/>
                                    </Border>
                                    <Button Style="{StaticResource Link}" Content="↺" ToolTip="Follow the All games slider again"
                                            Click="ResetRow_Click" Tag="{Binding}" Margin="2,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Preview" Click="PreviewRow_Click" Tag="{Binding}" Margin="0,0,6,0"
                                        IsEnabled="{Binding IsSupported}"/>
                                <Button Content="Apply" Style="{StaticResource Primary}" Click="ApplyRow_Click" Tag="{Binding}"
                                        IsEnabled="{Binding CanOptimize}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Content="Only games it can optimize" IsChecked="{Binding OnlySupported}" VerticalAlignment="Center"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                       Margin="16,0" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Restore last run" Click="Restore_Click" Margin="0,0,8,0"/>
                <Button Content="Rescan" Click="Rescan_Click" Margin="0,0,8,0"/>
                <Button Content="Optimize all" Style="{StaticResource Primary}" Click="OptimizeAll_Click" Padding="20,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
