<Window x:Class="GameOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameOptimizer.App"
        Title="GameOptimizer" Width="1180" Height="820" MinWidth="900" MinHeight="560"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <local:InvertBool x:Key="InvertBool"/>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" Padding="8,2">
            <MenuItem Header="_Library">
                <MenuItem Header="_Add a game folder..." Click="AddFolder_Click" Foreground="Black"/>
                <MenuItem Header="_Manage added folders..." Click="ManageFolders_Click" Foreground="Black"/>
                <Separator/>
                <MenuItem Header="_Rescan" Click="Rescan_Click" Foreground="Black" InputGestureText="F5"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_History and restore..." Click="History_Click" Foreground="Black"/>
                <MenuItem Header="_Benchmarks..." Click="Benchmarks_Click" Foreground="Black"/>
                <MenuItem Header="Rule _wizard..." Click="Wizard_Click" Foreground="Black"/>
                <MenuItem Header="_Check rule files..." Click="ValidateRules_Click" Foreground="Black"/>
            </MenuItem>
            <MenuItem Header="_Preferences">
                <MenuItem Header="_Profiles..." Click="Profiles_Click" Foreground="Black"/>
                <Separator/>
                <MenuItem Header="_Export preferences..." Click="Export_Click" Foreground="Black"/>
                <MenuItem Header="_Import preferences..." Click="Import_Click" Foreground="Black"/>
            </MenuItem>
        </Menu>
        <Grid Margin="20,14,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="GameOptimizer" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding HardwareText}" Style="{StaticResource Small}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding DisplayText}" Style="{StaticResource Small}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- All games -->
            <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="18,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="All games" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding GlobalLabel}" Foreground="{StaticResource Accent}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,24,0">
                        <Slider x:Name="GlobalSlider" Minimum="-3" Maximum="3" Value="{Binding GlobalOffset, Mode=TwoWay}"
                                AutomationProperties.Name="Quality offset for all games"
                                IsEnabled="{Binding Busy, Converter={StaticResource InvertBool}}"/>
                        <Canvas x:Name="GlobalTicks" Height="22" ClipToBounds="False"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Back to recommended" Click="UseRecommended_Click" VerticalAlignment="Center"/>
                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
                        <TextBlock Text="Default profile" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding DefaultProfileChoices}" SelectedValuePath="Key" SelectedValue="{Binding DefaultProfile}"
                                  Width="170" Margin="0,0,8,0" AutomationProperties.Name="Default profile" ToolTip="{Binding DefaultProfileText}"/>
                        <Button Content="Profiles..." Click="Profiles_Click" Margin="0,0,24,0"/>
                        <TextBlock Text="Gaming display" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding GamingDisplayChoices}" SelectedValuePath="Key" SelectedValue="{Binding GamingDisplay}"
                                  Width="300" AutomationProperties.Name="Gaming display" ToolTip="Used for resolution and the automatic frame cap. Windows display settings are never changed."/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Search, filters, selection -->
            <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="Search" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,12,0" Padding="4,2"
                         AutomationProperties.Name="Search games"/>
                <ComboBox ItemsSource="{Binding StoreFilters}" SelectedItem="{Binding StoreFilter}" Width="120" Margin="0,0,6,0" AutomationProperties.Name="Store filter"/>
                <ComboBox ItemsSource="{Binding EngineFilters}" SelectedItem="{Binding EngineFilter}" Width="120" Margin="0,0,6,0" AutomationProperties.Name="Engine filter"/>
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="160" Margin="0,0,10,0" AutomationProperties.Name="Status filter"/>
                <CheckBox Content="My own choices" IsChecked="{Binding OnlyCustom}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <CheckBox Content="Changes waiting" IsChecked="{Binding OnlyPending}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="Select shown" Click="SelectShown_Click" Margin="0,0,6,0"/>
                <Button Content="Clear selection" Click="ClearSelection_Click" Margin="0,0,10,0"/>
                <TextBlock x:Name="ShownText" Style="{StaticResource Label}"/>
            </WrapPanel>

            <!-- Game list -->
            <ListBox Grid.Row="3" x:Name="GameList" ItemsSource="{Binding Games}" Background="Transparent" Foreground="{StaticResource Text}" BorderThickness="0"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     KeyboardNavigation.TabNavigation="Continue">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsTabStop" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter Margin="0,0,0,6"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="220"/>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"
                                              AutomationProperties.Name="{Binding Name, StringFormat=Select {0}}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding EngineText}" Style="{StaticResource Small}"/>
                                            <TextBlock Text="  ·  " Style="{StaticResource Small}"/>
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="  ⚠" Foreground="{StaticResource Warn}" ToolTip="{Binding WarningText}"
                                                       Visibility="{Binding HasWarning, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="-4,2,0,0">
                                            <ItemsControl ItemsSource="{Binding Links}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource Link}" Tag="{Binding Url}" ToolTip="{Binding Url}" Click="Link_Click">
                                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Custom}" FontSize="11"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Style="{StaticResource Link}" Click="OpenFolder_Click" Tag="{Binding}" Visibility="{Binding CanOpenFolder, Converter={StaticResource Vis}}">
                                                <TextBlock Text="Open settings folder" Foreground="{StaticResource Custom}" FontSize="11"/>
                                            </Button>
                                            <Button Style="{StaticResource Link}" Click="AddRule_Click" Tag="{Binding}" Visibility="{Binding CanAddRule, Converter={StaticResource Vis}}">
                                                <TextBlock Text="Add a rule" Foreground="{StaticResource Custom}" FontSize="11"/>
                                            </Button>
                                            <Button Style="{StaticResource Link}" Click="Launch_Click" Tag="{Binding}" Visibility="{Binding CanLaunch, Converter={StaticResource Vis}}">
                                                <TextBlock Text="Launch once, then rescan" Foreground="{StaticResource Custom}" FontSize="11"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                        <Slider Value="{Binding Step, Mode=TwoWay}" IsEnabled="{Binding IsSupported}"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Quality step for {0}}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0" ToolTip="{Binding RecDetails}">
                                            <TextBlock Text="{Binding RecText}" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AtRecommended}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Background="#2A2F3A" CornerRadius="4" Padding="5,0" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding BasisChip}" FontSize="10" Foreground="{StaticResource Muted}"/>
                                            </Border>
                                            <Border Background="#22324F" CornerRadius="4" Padding="5,0" Margin="4,0,0,0" Visibility="{Binding HasMeasured, Converter={StaticResource Vis}}">
                                                <TextBlock Text="measured" FontSize="10" Foreground="{StaticResource Custom}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                        <StackPanel VerticalAlignment="Center" Width="74">
                                            <TextBlock Text="{Binding StepLabel}"/>
                                            <TextBlock Text="{Binding StepSource}" Style="{StaticResource Small}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding StepSource}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustom, Converter={StaticResource Vis}}">
                                            <Border Background="#22324F" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="custom" Foreground="{StaticResource Custom}" FontSize="11"/>
                                            </Border>
                                            <Button Style="{StaticResource Link}" Content="↺" ToolTip="Back to the profile's quality" Click="ResetRow_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleButton Content="Settings" IsChecked="{Binding IsExpanded}" Margin="0,0,6,0" Padding="10,6"
                                                      Foreground="{StaticResource Text}" Background="{StaticResource PanelHi}" BorderBrush="{StaticResource Line}"
                                                      IsEnabled="{Binding IsSupported}"/>
                                        <Button Content="Preview" Click="PreviewRow_Click" Tag="{Binding}" Margin="0,0,6,0" IsEnabled="{Binding IsSupported}"/>
                                        <Button Content="Apply" Style="{StaticResource Primary}" Click="ApplyRow_Click" Tag="{Binding}" IsEnabled="{Binding CanOptimize}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Per-game settings -->
                                <Border Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" Background="{StaticResource PanelHi}"
                                        CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding EffectiveText}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding NotControlledText}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Visibility="{Binding HasNotControlled, Converter={StaticResource Vis}}"/>
                                        <WrapPanel>
                                            <TextBlock Text="Profile" Style="{StaticResource Label}"/>
                                            <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedValuePath="Key" SelectedValue="{Binding ProfileKey}" Width="170" Margin="0,0,16,4"/>
                                            <TextBlock Text="Frame cap" Style="{StaticResource Label}"/>
                                            <ComboBox ItemsSource="{Binding FpsChoices}" SelectedValuePath="Key" SelectedValue="{Binding FpsKey}" Width="270" Margin="0,0,6,4"
                                                      ToolTip="A frame limiter caps how fast the game renders. It does not make the hardware reach that rate, and it does not replace VSync."/>
                                            <TextBox Text="{Binding CustomFps, UpdateSourceTrigger=LostFocus}" Width="60" Margin="0,0,4,4" Padding="4,2" ToolTip="Custom cap in fps (10 to 1000)"
                                                     AutomationProperties.Name="Custom frame cap"/>
                                            <TextBlock Text="fps" Style="{StaticResource Label}" Margin="0,0,16,0"/>
                                        </WrapPanel>
                                        <WrapPanel>
                                            <TextBlock Text="Display" Style="{StaticResource Label}"/>
                                            <ComboBox ItemsSource="{Binding DisplayChoices}" SelectedValuePath="Key" SelectedValue="{Binding DisplayKey}" Width="280" Margin="0,0,16,4"/>
                                            <TextBlock Text="Resolution" Style="{StaticResource Label}"/>
                                            <ComboBox ItemsSource="{Binding ResolutionChoices}" SelectedValuePath="Key" SelectedValue="{Binding ResolutionKey}" Width="180" Margin="0,0,16,4"/>
                                            <TextBlock Text="Display mode" Style="{StaticResource Label}"/>
                                            <ComboBox ItemsSource="{Binding DisplayModeChoices}" SelectedValuePath="Key" SelectedValue="{Binding DisplayModeKey}" Width="180" Margin="0,0,16,4"/>
                                            <TextBlock Text="VSync" Style="{StaticResource Label}"/>
                                            <ComboBox ItemsSource="{Binding VSyncChoices}" SelectedValuePath="Key" SelectedValue="{Binding VSyncKey}" Width="140" Margin="0,0,0,4"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <TextBlock Text="Keep as the game has it:" Style="{StaticResource Label}"/>
                                            <CheckBox Content="Resolution" IsChecked="{Binding KeepResolution}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <CheckBox Content="Display mode" IsChecked="{Binding KeepDisplayMode}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <CheckBox Content="VSync" IsChecked="{Binding KeepVSync}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <CheckBox Content="Frame cap" IsChecked="{Binding KeepFps}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <CheckBox Content="Render scale" IsChecked="{Binding KeepRenderScale}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <CheckBox Content="Textures" IsChecked="{Binding KeepTexture}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <CheckBox Content="Other quality" IsChecked="{Binding KeepQuality}" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasExclusions, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding ExcludedText}" Style="{StaticResource Small}" TextWrapping="Wrap" MaxWidth="760" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource Link}" Click="ClearKept_Click" Tag="{Binding}">
                                                <TextBlock Text="Stop keeping these" Foreground="{StaticResource Custom}" FontSize="11"/>
                                            </Button>
                                        </StackPanel>
                                        <WrapPanel Margin="0,6,0,0" Visibility="{Binding CanLinkAppId, Converter={StaticResource Vis}}">
                                            <TextBlock Text="Steam app id for requirement lookups" Style="{StaticResource Label}"/>
                                            <TextBox Text="{Binding SteamAppId, UpdateSourceTrigger=LostFocus}" Width="90" Padding="4,2" Margin="0,0,8,0"
                                                     ToolTip="Only a number you look up yourself. The tool never guesses an id from the name."/>
                                        </WrapPanel>
                                        <DockPanel Margin="0,6,0,0">
                                            <Button DockPanel.Dock="Right" Content="Reset this game's choices" Click="ResetChoices_Click" Tag="{Binding}" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding AppIdSource}" Style="{StaticResource Small}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer -->
            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Click="PreviewSelected_Click" Margin="0,0,8,0">
                        <TextBlock Text="{Binding SelectedButtonsText, StringFormat=Preview {0}}"/>
                    </Button>
                    <Button Click="ApplySelected_Click" Margin="0,0,16,0">
                        <TextBlock Text="{Binding SelectedButtonsText, StringFormat=Optimize {0}}"/>
                    </Button>
                    <Button Style="{StaticResource Primary}" Click="OptimizeAll_Click" Padding="18,8"
                            ToolTip="Every game the tool can change, whatever the search and filters show. A preview comes first.">
                        <TextBlock Text="{Binding OptimizeAllText}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
